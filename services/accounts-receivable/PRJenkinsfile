#!groovy

properties([
    [
        $class: 'DatadogJobProperty',
        tagProperties: "jenkins.job.duration,jenkins.job.status"
    ],
    disableConcurrentBuilds()
])

node('dev') {
    cleanWs()
    def COMPOSE_COMMAND
    stage('Prep') {
        SCM_CHECKOUT = checkout scm

        env.ARTIFACTORY_VIRTUAL_REPOSITORY_URL = "registry.example.io/tag-docker-prod-virtual-us/"
        env.CHANGE_BRANCH = env.CHANGE_BRANCH.replaceAll(/[^a-zA-Z0-9_-]/, '')
        env.VERSION="${env.CHANGE_BRANCH}-${env.BUILD_NUMBER}"
        env.GIT_COMMIT=SCM_CHECKOUT.GIT_COMMIT

        buildName "${env.BUILD_NUMBER}) ${env.CHANGE_BRANCH}"
        buildDescription "${env.CHANGE_BRANCH} => ${env.CHANGE_TARGET}. \nChange Author: ${env.CHANGE_AUTHOR}"

        COMPOSE_COMMAND = "docker-compose -f docker-compose.yml -f docker-compose.override.yml -p ${env.VERSION}"
    }

    stage('Check if Behind Target Branch') {
        // Check if the current branch is behind the target branch
        def behindCount = sh(script: "git rev-list --right-only --count HEAD...origin/${env.CHANGE_TARGET}", returnStdout: true).trim()
        def isBehind = (behindCount != '0')

        if (isBehind) {
            // Fail the build and exit
            currentBuild.result = 'FAILURE'
            error("The branch ${env.CHANGE_BRANCH} is behind ${env.CHANGE_TARGET} by ${behindCount} commits. Please merge the latest changes from ${env.CHANGE_TARGET} into ${env.CHANGE_BRANCH}.")
        } else {
            echo "The branch ${env.CHANGE_BRANCH} is up-to-date with ${env.CHANGE_TARGET}."
        }
    }

    try {
        ansiColor('xterm') {
            stage("Build Docker Images") {
                withDockerRegistry(credentialsId: 'tag-devops-cloud-artifactory-creds', url: 'https://registry.example.io/') {
                    // Building the images requires the GITHUB_USERNAME and GITHUB_AUTH_TOKEN env vars to retrieve private Golang deps
                    withCredentials([usernamePassword(credentialsId: 'jenkins-default-GitHub-Token-example-org', passwordVariable: 'GITHUB_AUTH_TOKEN', usernameVariable: 'GITHUB_USERNAME')]) {
                        // Pull all external images via Artifactory to bypass Docker Hub pull limit
                        withEnv(["REPOSITORY_URL=${env.ARTIFACTORY_VIRTUAL_REPOSITORY_URL}"]) {
                            // Build all required images
                            sh "make docker-build DOCKER_COMPOSE='${COMPOSE_COMMAND}'"
                        }
                    }
                }
            }

            stage('Unit Tests') {
                sh "make docker-unit-test build=false DOCKER_COMPOSE='${COMPOSE_COMMAND}'"
                if (fileExists ('./outputs/test_coverage.out')) {
                    archiveArtifacts artifacts: 'outputs/test_coverage.*', fingerprint: true
                    try {
                        sh "curl https://deepsource.io/cli | sh"
                        withCredentials([string(credentialsId: 'ps-tag-accounts-receivable-deepsource-dsn', variable: 'DEEPSOURCE_DSN')]) {
                            sh "./bin/deepsource report --analyzer test-coverage --key go --value-file ./outputs/test_coverage.out"
                        }
                    } catch (Exception e) {
                        println "Code coverage upload to DeepSource failed: ${e}"
                    }
                }
            }

            stage('Integration Tests') {
                withDockerRegistry(credentialsId: 'tag-devops-cloud-artifactory-creds', url: 'https://registry.example.io/') {
                    // Pull all external images via Artifactory to bypass Docker Hub pull limit
                    withEnv(["REPOSITORY_URL=${env.ARTIFACTORY_VIRTUAL_REPOSITORY_URL}"]) {
                        sh "make docker-integration-test build=false DOCKER_COMPOSE='${COMPOSE_COMMAND}'"
                    }
                }
            }

            def tfContainer = docker.image("registry.example.io/docker-prod/app/tag-utilities/tag-terraform:1.6.5")
            stage('Infrastructure Validation') {
                withDockerRegistry(credentialsId: 'tag-devops-cloud-artifactory-creds', url: 'https://registry.example.io/') {
                    tfContainer.inside("-e TF_VAR_app_version=${env.VERSION} --entrypoint=''") {
                        withCredentials([gitUsernamePassword(credentialsId: 'jenkins-default-GitHub-Token-example-org', gitToolName: 'Default')]) {
                            dir("deployments/terraform/root-module") {
                                sh "terraform init -backend-config=../environments/dev/us-east-1/dev.backend"
                                sh "terraform plan --var-file=../environments/dev/us-east-1/dev.tfvars"
                            }
                        }
                    }
                }
            }
        }
    } catch (Exception e) {
        currentBuild.result = 'FAILURE'
        println e.toString()
    } finally {
        def logFile = "${env.CHANGE_BRANCH}-${env.BUILD_NUMBER}.log"
        sh "${COMPOSE_COMMAND} logs > ${logFile}"
        zip archive: true, glob: "${logFile}", zipFile: "${logFile}.zip"

        sh "make docker-clean DOCKER_COMPOSE='${COMPOSE_COMMAND}'"
        notifyGoogle(currentBuild.result, "Accounts Receivable Pull Request")
    }
}
