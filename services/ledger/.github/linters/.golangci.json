        "text": "502:"
      },{
        "linters": [
          "gosec"
        ],
        "text": "G114:"
      },{
        "linters": [
          "gosimple"
        ],
        "text": "S1011:"
      },
      {
        "linters": [
          "govet"
        ],
        "text": "copylocks:"
      },{
        "linters": [
          "ineffassign"
