{
  "run": {
    "tests": true
  },
  "linters-settings": {
    "govet": {
      "disable": [
        "composites"
      ]
    }
  },
  "linters": {
    "enable": [
      "unconvert",
      "goimports",
      "gosec"
    ],
    "disable": [
      "unused",
      "errcheck"
    ]
  },
  "issues": {
    "max-same-issues": 0,
    "max-issues-per-linter": 0,
    "exclude-rules": [
      {
        "linters": [
          "staticcheck"
        ],
        "text": "SA9004:"
      },
      {
        "linters": [
          "staticcheck"
        ],
        "text": "SA5001:"
      },
      {
        "linters": [
          "staticcheck"
        ],
        "text": "SA5011:"
      }, {
        "linters": [
          "staticcheck"
        ],
        "text": "SA1019:"
      }, {
        "linters": [
          "gosec"
        ],
        "text": "G203:"
      },{
        "linters": [
          "gosec"
        ],
        "text": "G101:"
      },{
        "linters": [
          "gosec"
        ],
        "text": "G102:"
      },{
        "linters": [
          "gosec"
        ],
        "text": "G106:"
      },{
        "linters": [
          "gosec"
        ],
        "text": "401:"
      },{
        "linters": [
          "gosec"
        ],
        "text": "402:"
      },{
        "linters": [
