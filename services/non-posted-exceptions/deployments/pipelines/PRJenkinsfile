#!groovy
/* groovylint-disable NestedBlockDepth */

properties([
        [
                $class       : 'DatadogJobProperty',
                tagProperties: 'jenkins.job.duration,jenkins.job.status'
        ],
        disableConcurrentBuilds()
])

node('dev') {
    cleanWs()
    def COMPOSE_COMMAND
    String DOCKER_URL = "https://registry.example.io"
    String githubCredentialsId = 'jenkins-default-GitHub-Token-example-org'
    String artifactoryCredentialsId = 'tag-devops-cloud-artifactory-creds'

    withDockerRegistry(
            credentialsId: artifactoryCredentialsId,
            url: DOCKER_URL
    ) {
        stage('Prep') {
            SCM_CHECKOUT = checkout scm

            env.VERSION = "${env.CHANGE_BRANCH}-${env.BUILD_NUMBER}"
            env.GIT_COMMIT = SCM_CHECKOUT.GIT_COMMIT

            buildName "${env.BUILD_NUMBER}) ${env.CHANGE_BRANCH}"
            buildDescription "${env.CHANGE_BRANCH} => ${env.CHANGE_TARGET}. \nChange Author: ${env.CHANGE_AUTHOR}"

            COMPOSE_COMMAND = "docker-compose -f docker-compose.yml -f docker-compose.jenkins.yml -p ${env.VERSION}"
            sh "${COMPOSE_COMMAND} pull"
            sh "${COMPOSE_COMMAND} up -d builder"
        }

        try {
            ansiColor('xterm') {
                stage('Generate Avro Models') {
                    sh "${COMPOSE_COMMAND} exec -T builder bash -c 'GOBIN=/opt/go/bin make generate-avro-models'"
                }

                stage('Download Dependencies') {
                    docker.image('registry.example.io/tag-docker-nonprod-virtual-us/golang:1.21.3').inside("-v ${env.WORKSPACE}/.mod:/go/pkg/mod -u root") {
                        withCredentials([gitUsernamePassword(credentialsId: githubCredentialsId,
                                gitToolName: 'Default')]) {
                            sh 'go mod download'
                            sh 'go mod vendor'
                        }
                    }
                }

                stage('Build Binary') {
                    withCredentials([gitUsernamePassword(credentialsId: githubCredentialsId, gitToolName: 'Default')]) {
                        sh "${COMPOSE_COMMAND} exec -T builder bash -c 'make compile'"
                    }
                }

                stage('Go Lint') {
                    sh "${COMPOSE_COMMAND} exec -T builder bash -c 'GOBIN=/opt/go/bin make install-linter; make lint'"
                }

                stage('Go Unit Tests') {
                    sh "${COMPOSE_COMMAND} exec -T builder bash -c 'make unit-test'"
                }

                stage('Go Race Condition Check') {
                    sh "${COMPOSE_COMMAND} exec -T builder bash -c 'make race'"
                }

                def tfContainer = docker.image("hashicorp/terraform:1.6.5")
                stage('Infrastructure Validation') {
                    tfContainer.inside("-e TF_VAR_app_version=${env.VERSION} --entrypoint=''") {
                        withCredentials([gitUsernamePassword(credentialsId: githubCredentialsId,
                                gitToolName: 'Default')]) {
                            dir("deployments/terraform/root-module") {
                                sh "terraform init -backend-config=../environments/dev/us-east-1/dev.backend"
                                sh "terraform plan --var-file=../environments/dev/us-east-1/dev.tfvars"
                            }
                        }
                    }
                }
            }
        } catch (Exception e) {
            currentBuild.result = 'FAILURE'
            println e.toString()
        } finally {
            sh "${COMPOSE_COMMAND} down"
            notifyGoogle(currentBuild.result, 'NPE Pull Request')
        }
    }
}
