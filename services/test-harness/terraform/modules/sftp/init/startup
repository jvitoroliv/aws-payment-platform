# init_sftp.sh
echo "#\!/bin/bash" >> /Docker/init_sftp.sh
echo "for user_home in /home*//* ; do" >> /Docker/init_sftp.sh
echo "  if [ -d "\"\$user_home\"" ]; then" >> /Docker/init_sftp.sh
echo "    username='basename $user_home'" >> /Docker/init_sftp.sh
echo "    mkdir -p \$user_home/input" >> /Docker/init_sftp.sh
echo "    chown -R \$username:users \$user_home/input" >> /Docker/init_sftp.sh
