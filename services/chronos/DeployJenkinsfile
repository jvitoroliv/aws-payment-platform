#!groovy
properties(
    [
        parameters([
            choice(choices: ["us-east-1", "us-west-2"].join("\n"),
                    description: 'Region',
                    name: 'REGION'),
            choice(choices: ["dev", "test", "stage", "prod"].join("\n"),
                    description: 'environment',
                    name: 'ENVIRONMENT'),
            choice(choices: ["yes", "no"].join("\n"),
                    description: 'Run Oneshotter?',
                    name: 'runOneShots'),
            string(defaultValue: '', name: 'VERSION',
                    description: 'Code version to deploy. Leave empty to maintain current version.'),
            choice(choices: ['current', 'us-east-1', 'us-west-2'], name: 'ACTIVE_REGION',
                    description: 'AWS Region to set as active. \'current\' will leave as currently configured.'),
        ]),
        ([
            $class: 'DatadogJobProperty',
            tagProperties: "jenkins.job.duration,jenkins.job.status"
        ])
    ]
)

disableConcurrentBuilds()

node("${params.ENVIRONMENT}") {
    ansiColor('xterm') {
        checkout scm
        buildDescription "${params.VERSION} => ${params.ENVIRONMENT}:${params.REGION}"
        try {
            // If active region is staying the same, set it to '' so Terraform will use the previous value
            activeRegion = params.ACTIVE_REGION
            if (activeRegion == 'current') {
                activeRegion = ''
            }

            // Only validate and upload artifacts if VERSION is not empty
            if (params.VERSION?.trim()) {

                if (params.ENVIRONMENT == "prod" && params.VERSION == "latest") {
                    throw new Exception("Specific commit version required for prod deploys.")
                }

                if (params.ENVIRONMENT == "prod") {
                    stage('Promote build ') {
                        withCredentials([usernamePassword(credentialsId: 'tag-devops-cloud-artifactory-creds', usernameVariable: 'USERNAME', passwordVariable: 'TOKEN')]) {
                            docker.image("releases-docker.jfrog.io/jfrog/jfrog-cli-v2-jf").inside('-u root') {
                                sh "jf c add --url=https://registry.example.io/ --access-token=${TOKEN}"
                                sh "jf rt build-promote ps-tag-chronos ${VERSION} tag-generic-prod-federated-us --status=promoted --copy"
                            }
                        }
                    }
                }
                dir("scripts") {
                    stage('Upload to S3') {
                        withCredentials([usernamePassword(credentialsId: 'tag-devops-cloud-artifactory-creds', passwordVariable: 'ARTIFACTORY_PASSWORD', usernameVariable: 'ARTIFACTORY_USER')]) {
                            withEnv(["ARTIFACTORY_ENDPOINT=https://registry.example.io/artifactory/tag-generic-${params.ENVIRONMENT == "prod" ? "prod" : "nonprod"}-federated-us"]) {
                                sh "./place_lambdas_in_s3.sh ${params.VERSION} ${params.ENVIRONMENT}"
                            }
                        }
                    }
                }
            }

            if ('yes'.equals(params.runOneShots)) {
                if(!params.VERSION?.trim()) {
                    throw new Exception("OneShotter requires VERSION to be specified.")
                }
                String oneShotBranch = "master"
                if (params.VERSION.count("-") == 3) {
                    oneShotBranch = params.VERSION.substring(3, 14)
                }
                build job: 'DBDataMigrationTool/ps-tag-chronos/master', propagate: true, wait: true, parameters: [string(name: 'ENVIRONMENT', value: "${params.ENVIRONMENT}"), string(name: 'BRANCH', value: "${oneShotBranch}")]
            }

            withDockerRegistry(credentialsId: 'tag-devops-cloud-artifactory-creds', url: 'https://registry.example.io') {
                docker.image("registry.example.io/docker-prod/app/tag-utilities/tag-terraform:1.6.5").inside("-e TF_VAR_environment=${params.ENVIRONMENT} -e TF_VAR_code_version=${params.VERSION} -e TF_VAR_active_region=${activeRegion} --entrypoint=''") {
                    dir("terraform") {
                            stage("Terraform Plan") {
                                sh "ls -als"
                                sh "terraform init -backend-config=./env/${params.ENVIRONMENT}/${params.REGION}/${params.ENVIRONMENT}.backend --reconfigure"
                                sh "terraform plan --var-file=./env/${params.ENVIRONMENT}/${params.REGION}/${params.ENVIRONMENT}.tfvars -out=planfile"
                            }

                            if (params.ENVIRONMENT == "dev" || params.ENVIRONMENT == "test") {
                                proceed = true
                            } else {
                                proceed = userInputProceed(params.ENVIRONMENT)
                            }

                            if (proceed) {
                                stage("Terraform Apply") {
                                    sh "terraform apply -auto-approve planfile"
                                }
                            }
                    }
                }
            }
        } catch (Exception e) {
            currentBuild.result = 'FAILURE'
            println e.toString()
        } finally {
            notifyGoogle(currentBuild.result, "CHRONOS Deployment Build")
        }
    }
}

def userInputProceed(environment) {
    try {
        timeout(time: 1, unit: 'HOURS') {
            input(
                    id: "${environment}", message: 'Do you approve?', parameters: [
                    [$class: 'BooleanParameterDefinition', defaultValue: true, description: '', name: 'Please confirm']
            ])
        }
    } catch (Exception exception) { // input false
        echo 'Request timed out'
        echo "Exception: ${exception}"
        return false
    }
    return true
}
