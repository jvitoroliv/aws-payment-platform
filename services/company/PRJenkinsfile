#!groovy

properties([
    [
        $class: 'DatadogJobProperty',
        tagProperties: 'jenkins.job.duration,jenkins.job.status'
    ],
    disableConcurrentBuilds()
])

node('dev') {
    cleanWs()
    def COMPOSE_COMMAND
    String credentialsId = 'jenkins-default-GitHub-Token-example-org'
    stage('Prep') {
        SCM_CHECKOUT = checkout scm

        env.VERSION = "${env.CHANGE_BRANCH}-${env.BUILD_NUMBER}"
        env.VERSION = env.VERSION.replaceAll('#', '-')
        env.GIT_COMMIT = SCM_CHECKOUT.GIT_COMMIT

        buildName "${env.BUILD_NUMBER}) ${env.CHANGE_BRANCH}"
        buildDescription "${env.CHANGE_BRANCH} => ${env.CHANGE_TARGET}. \nChange Author: ${env.CHANGE_AUTHOR}"

        COMPOSE_COMMAND = "docker-compose -f docker-compose.yml -p ${env.VERSION}"
        withDockerRegistry(credentialsId: 'tag-devops-cloud-artifactory-creds', url: 'https://registry.example.io/') {
            sh "${COMPOSE_COMMAND} pull tester"
            sh "${COMPOSE_COMMAND} up -d tester"
        }
    }

    try {
        ansiColor('xterm') {
            stage('Download Dependencies') {
                docker.image("golang:1.21.3").inside("-v ${env.WORKSPACE}/.mod:/go/pkg/mod -u root") {
                    withCredentials([gitUsernamePassword(credentialsId: credentialsId, gitToolName: 'Default')]) {
                        sh 'go mod download'
                        sh 'go mod vendor'
                    }
                }
            }

            stage('Build Binary') {
                sh "${COMPOSE_COMMAND} exec -T tester bash -c './build/compile.sh'"
            }

            stage("Docker Compose") {
                withDockerRegistry(credentialsId: 'tag-devops-cloud-artifactory-creds', url: 'https://registry.example.io/') {
                    sh "${COMPOSE_COMMAND} up --build -d"
                }
            }

            stage('Go Unit Tests') {
                sh "${COMPOSE_COMMAND} exec -T tester bash -c 'make test'"
            }

            stage('Go Integration Tests') {
                sh "${COMPOSE_COMMAND} exec -T tester bash -c 'make integration-test'"
            }

            def tfContainer = docker.image('hashicorp/terraform:1.6.5')
            stage('Infrastructure Validation') {
                tfContainer.inside("-e TF_VAR_app_version=${env.VERSION} --entrypoint=''") {
                    withCredentials([gitUsernamePassword(credentialsId: 'jenkins-default-GitHub-Token-example-org', gitToolName: 'Default')]) {
                        dir('deployments/terraform/root-module') {
                            sh 'terraform init --backend-config=../environments/dev/us-east-1/dev.backend'
                            sh 'terraform validate'
                            sh 'terraform plan --var-file=../environments/dev/us-east-1/dev.tfvars'
                        }
                    }
                }
            }
        }
    } catch (Exception e) {
        currentBuild.result = 'FAILURE'
        println e.toString()
    } finally {
        def logFile = "${env.CHANGE_BRANCH}-${env.BUILD_NUMBER}.log"
        sh "${COMPOSE_COMMAND} logs > ${logFile}"
        zip archive: true, glob: "${logFile}", zipFile: "${logFile}.zip"

        sh "${COMPOSE_COMMAND} down"
        notifyGoogle(currentBuild.result, 'Company Pull Request')
    }
}
