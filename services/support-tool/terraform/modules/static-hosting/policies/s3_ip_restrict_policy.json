{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudFrontReadOnly",
      "Effect": "Allow",
      "Principal": {
        "CanonicalUser": "${cloudfront_oai}"
      },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::${bucket}/*"
    },
    {
      "Sid": "CloudFrontReadOnly",
      "Effect": "Allow",
      "Principal": {
        "CanonicalUser": "${cloudfront_oai}"
      },
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::${bucket}"
    }
  ]
}