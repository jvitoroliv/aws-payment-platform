    "dataSources": {
        "ds_C17LwbiK_ds_blocked_requests": {
            "name": "Blocked Requests - Common API",
            "options": {
                "query": "index=corp_prod_imperva_waf | where sourceServiceName=mvindex(split(\"$env$\", \",\"), 1) AND act!=\"REQ_PASSED\"\n| rex field=act \"(?<block_reason>.*)\"\n| eval timestamp=strftime(_time, \"%Y-%m-%d %H:%M:%S\")\n| eval combined_key=src . \" - \" . block_reason\n| timechart span=1h limit=10 count by combined_key useother=false\n| rename timestamp as Time\n| fillnull value=0",
                "queryParameters": {
                    "earliest": "$global_time.earliest$",
                    "latest": "$global_time.latest$"
                }
            },
            "type": "ds.search"
        },
        "ds_G17rm9BJ_ds_Ly7JMZNv": {
            "name": "non-www-imperva",
            "options": {
                "query": "index=corp_prod_imperva_waf sourceServiceName=\"www.platform.example.com\" AND url=\"platform.example.com*\"\n| eval client_ip = src | \neval client_source = case(\n{{CIDRMATCH_SECTION}}\n)\n| eval combined_key=client_source . \" - \" . act \n| timechart limit=0 count by combined_key"
            },
            "type": "ds.search"
        },
        "ds_Hj6LxCwa_ds_IyAVvo8L_ds_Ly7JMZNv": {
            "name": "www-imperva-blocked-known",
            "options": {
                "query": "index=corp_prod_imperva_waf sourceServiceName=\"www.platform.example.com\" AND url=\"www.platform.example.com*\" AND action!=\"allowed\"| \neval client_ip = src | \neval client_source = case(\n{{CIDRMATCH_SECTION}}\n)\n| search client_source!=\"Unknown - *\"\n| eval combined_key=client_source . \" - \" . act \n| timechart count by combined_key"
            },
