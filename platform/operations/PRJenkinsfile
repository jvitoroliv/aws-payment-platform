#!groovy

properties([
  disableConcurrentBuilds(),
  [
    $class: 'DatadogJobProperty',
    tagProperties: "jenkins.job.duration,jenkins.job.status"
  ]
])

node('dev') {
	try {
		ansiColor('xterm') {
			stage('Prep') {
				cleanWs()
				buildName "${env.BUILD_NUMBER}) ${env.CHANGE_BRANCH}"
				buildDescription "${env.CHANGE_BRANCH} => ${env.CHANGE_TARGET}. \nChange Author: ${env.CHANGE_AUTHOR}"
				deployEnv = "dev"
				env.ENVIRONMENT_VERSION = "${env.BRANCH_NAME}${env.BUILD_NUMBER}".toLowerCase().minus("pr").minus("-").take(6)
				//this needs to be all lowercase
				checkout scm
				env.AWS_DEFAULT_REGION = "us-east-1"
				env.ENVIRONMENT = 'dev'
				env.HOME = "${env.WORKSPACE}"
				env.GOPATH = "${env.WORKSPACE}/go"
			}
			def tfContainer = docker.image("hashicorp/terraform:1.6.5")

			def tagtfContainer = docker.image("registry.example.io/docker-prod/app/tag-utilities/tag-terraform:1.6.5")

			def stages = [:]
			stages['Plan'] = {
				tfContainer.pull()
				tfContainer.inside("--entrypoint=''") {

					stage('Plan') {
						dir("terraform/environments/dev/global") {
							sh "terraform init -reconfigure -backend-config=dev.backend"
							sh "terraform plan -out=global.dev.planfile"
						}
						dir("terraform/tag_core") {
							sh "terraform init -reconfigure -backend-config=../environments/dev/us-east-1/dev.backend"
							sh "terraform plan --var-file=../environments/dev/us-east-1/dev.tfvars -out=planfile"
						}

						dir("terraform/tag_core") {
							sh "terraform init -reconfigure -backend-config=../environments/dev/us-west-2/dev.backend"
							sh "terraform plan --var-file=../environments/dev/us-west-2/dev.tfvars -out=planfile"
						}
					}
				}
			}
			stages['Pre-Commit Hooks'] = {
				withDockerRegistry(
						credentialsId: 'tag-devops-cloud-artifactory-creds',
						url: 'https://registry.example.io/'
				) {
					tagtfContainer.pull()
					tagtfContainer.inside("--entrypoint=''") {
						stage('Pre-Commit Hooks') {
							dir("") {
								sh "pre-commit run --all-files"
							}
						}

					}
				}
			}
			parallel(stages)
		}
	} catch (Exception e){
		currentBuild.result = 'FAILURE'
		println e.toString()
	} finally {
		notifyGoogle(currentBuild.result, "OPS Pull Request Build")
	}
}
