#!/bin/bash

### Update OS
sudo yum update -y

### Install jq ###
sudo yum install -y jq

#install git
sudo yum install -y git

#install ssm package
sudo yum install -y https://s3.amazonaws.com/ec2-downloads-windows/SSMAgent/latest/linux_amd64/amazon-ssm-agent.rpm

#add ssm-user group
sudo groupadd -g 1025974 -f -r ssm-user

#add ssm-user
sudo useradd -u 1025974 -g 1025974 -s /bin/bash -r -p 'S3cur!ty.jpg!' ssm-user

#add ssm-user to correct groups
sudo usermod -a -G ssm-user,sudo ssm-user

#add thing to /etc/sudoers
sudo bash -c 'echo "ssm-user ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers'

#chage the thing
sudo chage -I -1 -m 0 -M 99999 -E -1 ssm-user

#install awscli
sudo apt-get install -y awscli

# Install docker and docker compose
sudo amazon-linux-extras install -y docker
sudo systemctl enable docker
sudo systemctl start docker

# Overwrite the default Docker subnet configuration
# The subnet range for our Mongo clusters conflicts with the default range for Docker
echo '
{
  "bip": "192.168.1.5/24",
  "default-address-pools": [
    {"base":"192.168.0.0/16","size":24}
  ]
}' | sudo tee /etc/docker/daemon.json

# Add the ec2-user to the 'docker' group
sudo usermod -aG docker ec2-user
sudo usermod -aG docker ssm-user

# Install docker compose
sudo curl -L "https://github.com/docker/compose/releases/latest/download/docker-compose-$(uname -s)-$(uname -m)" -o /usr/local/bin/docker-compose
sudo chmod +x /usr/local/bin/docker-compose

# Function to check if Docker is running
wait_for_docker() {
    echo "Waiting for Docker to be ready..."

    # Keep checking Docker status in a loop
    until docker info >/dev/null 2>&1; do
        # Print a dot every 2 seconds to show progress
        echo -n "."
        sleep 2
    done

    echo "Docker is ready!"
}

# Call the function to wait until Docker is ready
wait_for_docker

# Once Docker is ready, execute your docker commands
docker pull mongo:7.0